#VRML_SIM R2025a utf8
# Husky A300 TWO-FIELD APPLE ORCHARD: same orchard as husky_apple.wbt, without people, plus a second field.
# Each field = 4 rows x 11 apple trees trained as tall spindles (protos/AppleTree.proto), rows 2.5 m apart.
#   field 1: rows x = -3.75 ... 3.75   (corridors x = -2.5, 0, 2.5)
#   field 2: rows x = 8.75 ... 16.25   (12.5 m east: 5 m between the facing outer rows of the two fields)
# Trees: webots-agri/tools/gen_apple_rows.py webots-agri/worlds/dos_fields.wbt --z 0.14 --rows 4 --per-row 11
#        webots-agri/tools/gen_apple_rows.py webots-agri/worlds/dos_fields.wbt --z 0.14 --rows 4 --per-row 11 --field 2 --x-offset 12.5 --seed 22
# The robot starts in the SOUTH headland, on the corridor centre line x = 0, facing north (+Y).

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "../protos/HuskyDroneCarrier.proto"
EXTERNPROTO "../protos/AppleTree.proto"
EXTERNPROTO "../protos/FieldTerrain.proto"

EXTERNPROTO "../protos/InspectionDrone.proto"

WorldInfo {
  info [ "AiGB UEx - Husky A300 apple orchard, two fields (tall spindle, raised beds, no people)" ]
  basicTimeStep 8
  # GPS: WGS84 so the "gps" device returns latitude / longitude / altitude.
  # Reference = world origin, near the UEx campus in Badajoz. With northDirection 0 1 0, world +Y is
  # geographic north, +X is east (ENU).
  gpsCoordinateSystem "WGS84"
  gpsReference 38.8794 -6.9707 186
  northDirection 0 1 0
  contactProperties [
    ContactProperties {
      # Skid-steer on firm soil. Isotropic grip: a skid-steer turns by dragging its wheels sideways,
      # so lateral slip is part of the model (and the source of the odometry rotation scrub the
      # wheels+IMU fusion must correct). softCFM: four coplanar contacts on a rigid body rock under a
      # hard solver; a little compliance shares the load smoothly.
      material1 "HuskyWheelMat"
      coulombFriction [ 0.9 ]
      bounce 0
      softCFM 0.0005
    }
  ]
}
Viewpoint {
  orientation -0.33 0.33 0.88 1.70
  position 0 -17 7
  follow "husky"
}
TexturedBackground {
  texture "noon_cloudy_countryside"
}
TexturedBackgroundLight {
  texture "noon_cloudy_countryside"
}
# Ground: beds under the tree rows of both fields (x = -3.75 ... 3.75 and 8.75 ... 16.25, y -7 ... 7), corridors and
# headlands at z ~ 0. The terrain is centred between the fields (x = 6.25), so rowX is in its local frame (world x - 6.25).
FieldTerrain {
  translation 6.25 0 0
  size 46 36
  rowX [ -10 -7.5 -5 -2.5 2.5 5 7.5 10 ]
  bedYMin -7.0
  bedYMax 7.0
}
DEF husky HuskyDroneCarrier {
  translation 0 -10.5 0.05
}
